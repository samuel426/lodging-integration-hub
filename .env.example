# JDBC URL for the PostgreSQL database.
DB_URL=

# PostgreSQL application user.
DB_USERNAME=

# PostgreSQL application password.
DB_PASSWORD=

# Supplier A HTTP base URL and API key, passed through the process environment.
SUPPLIER_A_BASE_URL=
SUPPLIER_A_API_KEY=

# Supplier B HTTP base URL and API key, passed through the process environment.
SUPPLIER_B_BASE_URL=
SUPPLIER_B_API_KEY=

# Whether to synchronize catalogs once during application startup.
CATALOG_SYNC_ON_STARTUP=
