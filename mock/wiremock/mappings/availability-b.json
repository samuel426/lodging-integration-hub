    "urlPath": "/b/api/search",
    "headers": {
      "X-Api-Key": {
        "equalTo": "local-mock-b"
      }
    },
    "queryParameters": {
      "propertyIds": {
        "equalTo": "meadow-201"
      },
      "checkIn": {
        "equalTo": "2026-10-10"
